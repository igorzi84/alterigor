# Local development only. Do not add real values to this file.
# Ordered, server-only OpenAI-compatible providers (up to three). The first is primary.
# Example: [{"displayName":"Groq Llama","baseUrl":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile","apiKeyEnv":"GROQ_API_KEY"},{"displayName":"OpenAI","baseUrl":"https://api.openai.com/v1","model":"your-model-id","apiKeyEnv":"OPENAI_API_KEY"}]
LLM_PROVIDERS=
# Define only the provider keys named by LLM_PROVIDERS. Never include a key in JSON.
GROQ_API_KEY=
OPENAI_API_KEY=
QUOTA_HMAC_SECRET=
ALTERIGOR_EXTENDED_PROFILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
SITE_URL=
